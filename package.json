{
  "name": "magical-athlete-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": { "express": "^5.1.0", "react": "^19.1.0", "react-dom": "^19.1.0", "socket.io": "^4.8.1", "socket.io-client": "^4.8.1", "zod": "^4.0.0" },
  "devDependencies": { "@playwright/test": "^1.56.0", "@types/express": "^5.0.0", "@types/node": "^24.0.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@vitejs/plugin-react": "^5.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0" }
}
