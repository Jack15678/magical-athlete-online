{
  "name": "magical-athlete-online",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/build-browser.mjs",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test tests/*.test.ts tests/host.test.mjs",
    "test:e2e": "playwright test",
    "build:browser": "node scripts/build-browser.mjs",
    "dev:browser": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test:relay": "playwright test -c playwright.relay.config.ts",
    "deploy:browser": "pnpm build:browser && wrangler deploy"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "4.151.3"
  }
}
