{
  "method": {
    "source": "Existing Edge browser requestAnimationFrame samples of DOM camera attributes, rounded to 0.01 world/zoom units.",
    "frameInterpretation": "Sampling intervals and distinct rounded camera-update intervals are reported separately. These are not GPU frame timings, pawn animation frame timings, or real-device FPS.",
    "translation": "Project camera target delta onto the current normal-view camera right/up vectors and multiply by mean orthographic zoom, approximating CSS pixels; excludes motion caused by changing zoom and camera orientation.",
    "speed": "Raw adjacent-sample speed is sensitive to quantization and asynchronous DOM/render sampling. Distinct-update intervals and >=100ms net-displacement windows are also reported; raw rate spikes do not by themselves verify a rendered speed-limit violation.",
    "rounding": "Each rounded x/z reading has <=0.005 world units error; a pairwise target delta can have <=0.01 error on each horizontal axis. Bound is conservatively sqrt(2)*0.01*meanZoom CSS pixels.",
    "validationLimitations": [
      "Mobile is a 390x844 desktop Edge viewport simulation, not a physical phone performance measurement.",
      "The supplied capture ends before camera convergence; tail position is not a settled-frame assertion.",
      "Screenshots during the trace can contribute sampling gaps; gaps alone do not establish dropped rendered frames."
    ]
  },
